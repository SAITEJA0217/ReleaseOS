# ==========================================
# ReleaseOS Environment Configuration Example
# ==========================================

# Database Connection (PostgreSQL or SQLite compatible via Prisma)
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/releaseos?schema=public
# SQLite fallback: file:./dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/releaseos?schema=public"

# LLM Provider Configuration (Server-Side Only - Never Exposed to Client)
# Supports Groq (recommended for ultra-fast inference) or OpenAI compatible providers.
# If omitted or invalid, ReleaseOS safely runs in deterministic Demo Mode with realistic verification flags.
GROQ_API_KEY="gsk_your_groq_api_key_here"
# Or OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
OPENAI_MODEL="llama-3.3-70b-versatile"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to true to explicitly force Demo Mode with simulated latency & deterministic rule validation
DEMO_MODE="false"
